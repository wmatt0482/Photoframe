<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app and the share extension share this app group; KeychainStore uses it as the Keychain access group for the sign-in. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.matthuber.photoframe</string>
	</array>
</dict>
</plist>
